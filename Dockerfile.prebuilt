# 只编译 Rust，前端产物由本地预先构建后传入。
#
# 为什么不用标准 Dockerfile：
#   标准 Dockerfile 的第一阶段会在容器里跑 node + Vite 打包 admin-ui。
#   生产机内存有限（5.8GB），Vite 打包峰值会把整机拖进 OOM，
#   连带把同机上的其他服务一起搞挂。所以改为本地 `pnpm build` 出 dist，
#   随源码一起传上去，服务器只做 cargo build。
#
# 用法（在项目根目录）：
#   cd admin-ui && pnpm build && cd ..
#   docker build -f Dockerfile.prebuilt -t kiro-rs:<tag> .
#
# 注意：仓库根目录的 .dockerignore 排除了 admin-ui/dist/，
# 直接在仓库里用本文件会拿不到前端产物。部署脚本会把所需文件
# 复制到独立打包目录并另写一份 .dockerignore，见 deploy 流程。

FROM rust:1.92-alpine AS builder

RUN apk add --no-cache musl-dev openssl-dev openssl-libs-static

WORKDIR /app
COPY Cargo.toml Cargo.lock* ./
COPY src ./src
# rust-embed 在编译期把这个目录嵌进二进制（src/admin_ui/router.rs 的 #[folder]）
COPY admin-ui/dist ./admin-ui/dist

RUN cargo build --release

FROM alpine:3.21

RUN apk add --no-cache ca-certificates

WORKDIR /app
COPY --from=builder /app/target/release/kiro-rs /app/kiro-rs

VOLUME ["/app/config"]

EXPOSE 8990

CMD ["./kiro-rs", "-c", "/app/config/config.json", "--credentials", "/app/config/credentials.json"]
